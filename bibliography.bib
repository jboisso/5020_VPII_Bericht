@article{sedeek_troposphere_2023,
	title = {Troposphere {Delay} {Remote} {Sensing} {Using} {Single} {GPS} {Receiver}},
	volume = {11},
	issn = {2307-1877},
	url = {https://www.sciencedirect.com/science/article/pii/S230718772600341X},
	doi = {10.36909/jer.16821},
	abstract = {The most prominent spatially correlated errors in GNSS observations are well known to be atmospheric effects. The ionosphere and troposphere are the two main layers of the Atmosphere that cause delays in GNSS observations. A linear combination of dual-frequency data can be used to reduce ionospheric delays. Unlike the ionospheric delay, the tropospheric delay cannot be eliminated using the same methods. The troposphere is primarily associated with GPS. The delay it causes in GPS signals is regarded as one of the primary sources of errors that must be eliminated to determine accurate positions. This paper's main purpose is to develop new source code to estimate the effect of tropospheric delays at any GPS station. The tropospheric delay in this proposed code is estimated via sequential least-squares adjustment with a model based on the Niell Mapping Function (NMF). This model, known as the Tropospheric Delay Estimation program, was created in the MATLAB ® environment (TDE). This research presents the results of tropospheric delay for DOY 2, 2020, using actual data from ten ground-based IGS stations distributed across Antarctica, China, Canada, Fiji, Russia, Greenland, and Portugal. To validate the proposed code results, they were compared with tropospheric delay results from the International GNSS Service (IGS). Good agreement and high correlation were found between the two results. Compared with IGS, the proposed code's standard deviations range from 0.0000525 m to 0.008154 m, indicating the study's accuracy relative to IGS solutions. Finally, MATLAB can accurately estimate tropospheric delay with an adaptable temporal resolution for GPS users.},
	number = {3, Part B},
	urldate = {2026-09-29},
	journal = {Journal of Engineering Research},
	author = {Sedeek, Ahmed and Doma, Mohamed and Rabah, Mostafa and Elsayed, Ahmed},
	month = sep,
	year = {2023},
	keywords = {GNSS, IGS, NMF, Troposphere Delay},
	pages = {16821},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\jonat\\Zotero\\storage\\KWBLH4GZ\\Sedeek et al. - 2023 - Troposphere Delay Remote Sensing Using Single GPS Receiver.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\jonat\\Zotero\\storage\\VUVDVWAE\\S230718772600341X.html:text/html},
}

